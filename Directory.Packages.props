<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <!-- Azure OpenAI / AI -->
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <!-- Microsoft Agent Framework -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Abstractions" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.28.0" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <!-- Serialization -->
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>